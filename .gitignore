# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets: never commit. .env.example documents the variables instead.
.env
*.pem
*.key

# Local data: keep the folder, not its contents
data/*
!data/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Terraform (later projects)
.terraform/
*.tfstate
*.tfstate.*
